<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AmbientLightCalibrate</AssemblyName>
    <RootNamespace>AmbientLightCalibrate</RootNamespace>
    <ApplicationIcon>AmbientLightCalibrate.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>WPF0001;CA1416</NoWarn>
    <Version>1.1.0</Version>
    <Authors>Andrii Orlov (DeadSue)</Authors>
    <Copyright>Copyright 2026 Andrii Orlov (DeadSue)</Copyright>
    <Product>AmbientLightCalibrate</Product>
    <Description>Ambient-light-driven monitor brightness for Windows (colorimeter + DDC/CI)</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AndriyOrlov/AmbientLightCalibrate</RepositoryUrl>
  </PropertyGroup>
</Project>
