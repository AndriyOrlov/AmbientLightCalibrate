<Window x:Class="AmbientLightCalibrate.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AmbientLightCalibrate"
        Title="AmbientLightCalibrate" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16,14,16,14">
        <!-- ======================= main page ======================= -->
        <StackPanel x:Name="MainPage">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Static l:S.AppTitle}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <ToggleButton x:Name="AutoSwitch" Grid.Column="2" Style="{StaticResource Switch}" Click="AutoSwitch_Click"/>
            </Grid>

            <Grid Margin="0,10,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="2" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static l:S.Measure}" Padding="12,4" Margin="10,0,0,0" Click="Measure_Click"/>
            </Grid>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static l:S.Monitors}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="MonitorRows"/>
                    <Separator Margin="0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static l:S.AllMonitors}" VerticalAlignment="Center"/>
                        <Slider x:Name="AllSlider" Grid.Column="1" Minimum="40" Maximum="300" Value="120"
                                IsMoveToPointEnabled="True" ValueChanged="AllSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AllText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel x:Name="Presets" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static l:S.Offset}"/>
                        <TextBlock Text="{x:Static l:S.OffsetSub}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="-40" Maximum="60" TickFrequency="5"
                            IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OffsetText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="StartupSwitch_Click" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Static l:S.StartWithWindows}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button ToolTip="{x:Static l:S.Settings}" Click="Settings_Click" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                    <Button ToolTip="{x:Static l:S.Log}" Click="Log_Click" Padding="8,4" Margin="0,0,4,0">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                    <Button ToolTip="{x:Static l:S.Exit}" Click="Exit_Click" Padding="8,4">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ======================= settings page ======================= -->
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Click="Back_Click" Padding="8,4" ToolTip="{x:Static l:S.Back}">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}"/>
                </Button>
                <TextBlock Text="{x:Static l:S.Settings}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static l:S.BrightnessMaps}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static l:S.BrightnessMapsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <StackPanel x:Name="CalibRows"/>
                    <StackPanel x:Name="CalibPrompt" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock x:Name="CalibPromptText" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CalibStart" Content="{x:Static l:S.Start}" Padding="14,4" Margin="0,0,6,0" Click="CalibStart_Click"/>
                            <Button Content="{x:Static l:S.Cancel}" Padding="14,4" Click="CalibCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="CalibStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="{x:Static l:S.IntervalMin}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBox x:Name="IntervalBox" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Text="{x:Static l:S.Hysteresis}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBox x:Name="HystBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Text="{x:Static l:S.MaxStep}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBox x:Name="StepBox" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static l:S.CurveTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static l:S.CurveHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static l:S.Lux}" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static l:S.Nits}" Style="{StaticResource Caption}"/>
                    </Grid>
                    <StackPanel x:Name="CurveRows"/>
                    <Button Content="{x:Static l:S.AddPoint}" HorizontalAlignment="Left" Padding="10,3" Margin="0,6,0,0" Click="AddPoint_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{x:Static l:S.ArgyllFolder}"/>
                    <TextBox x:Name="ArgyllBox" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ArgyllFound" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="SaveError" Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="{x:Static l:S.Cancel}" Click="Back_Click" Padding="14,5" Margin="0,0,6,0"/>
                <Button Content="{x:Static l:S.Save}" Click="Save_Click" Padding="14,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
